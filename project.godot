; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="以太之圓"
run/main_scene="res://ui/title_screen.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[audio]

buses/default_bus_layout="res://sound/default_bus_layout.tres"
driver/output_latency=40

[autoload]

Game="*res://globals/game.tscn"
Vignette="res://globals/vignette.tscn"
VsGameManager="*res://VsMods/ui/VsGameManager.gd"
CombatManager="*res://Explod/CombatManager.gd"
PauseMenu="*res://ui/pause_menu.tscn"
AudioManager="*res://sound/AudioManager.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/always_on_top=true
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/com.timothyqiu.animation-resetter/plugin.cfg")

