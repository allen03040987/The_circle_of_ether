[layer_names]

2d_physics/layer_1="Environment"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="PlayerHortbox"
2d_physics/layer_5="EnemyHortbox"
2d_physics/layer_8="VsWorld"
2d_physics/layer_9="VsPlayer"
2d_physics/layer_10="VsHortbox"
2d_physics/layer_11="VsHitbox"
2d_physics/layer_12="VsPlayerCollider"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/use_physical_light_units=true
